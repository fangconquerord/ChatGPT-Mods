{
  "manifest_version": 3,
  "name": "ChatGPT Mods 中文版",
  "version": "1.2.1.5",
  "version_name": "1.2.1-cn.5",
  "description": "为 chatgpt.com 提供分屏、聊天导出、临时聊天保存、文件夹整理和本地提示词优化等界面增强。",
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16x16.png",
    "24": "icons/24x24.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "24": "icons/24x24.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-settings.js",
        "content-zh-CN.js",
        "content-chat-exporter.js",
        "content-chat-organizer.js",
        "prompt-compiler/namespace.js",
        "prompt-compiler/types.js",
        "prompt-compiler/rules-bundle.js",
        "prompt-compiler/normalization.js",
        "prompt-compiler/protection.js",
        "prompt-compiler/language.js",
        "prompt-compiler/segmentation.js",
        "prompt-compiler/classifier.js",
        "prompt-compiler/extraction.js",
        "prompt-compiler/context.js",
        "prompt-compiler/ambiguity.js",
        "prompt-compiler/planner.js",
        "prompt-compiler/synthesis.js",
        "prompt-compiler/renderer.js",
        "prompt-compiler/candidates.js",
        "prompt-compiler/scoring.js",
        "prompt-compiler/validation.js",
        "prompt-compiler/diagnostics.js",
        "prompt-compiler/rules-loader.js",
        "prompt-compiler/pipeline.js",
        "prompt-compiler/index.js",
        "content-temp-chat.js",
        "content-message-meta.js",
        "content-prompt-enhancer.js",
        "content-split-view.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
